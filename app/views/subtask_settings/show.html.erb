<% if @subtasks.first %>
<span><strong><%= l(:label_subtask_rules) %>:</strong></span>
<div class="box tabular">
<table>
<% @subtasks.each do |subtask| %>
    <%= form_tag(update_subtask_path(@project, subtask.id), method: :put, class: "tabular") do %>
      <tr>
        <td>
          <div class="box tabular">
          <%= l(:text_subtask_rule_parent) %>
          <%= select_tag(:parent, options_from_collection_for_select(@all_trackers, :id, :name, subtask.parent), {:disabled => true})  %>,
          <%= hidden_field_tag(:parent, subtask.parent) %>
          <%= l(:text_subtask_rule_child) %>
          <%= select_tag(:child, options_from_collection_for_select(@all_trackers, :id, :name, subtask.child), {:disabled => true}) %>.
          <%= hidden_field_tag(:child, subtask.child) %>
          </div>
        </td>
        <td>
          <div class="box tabular">
            <%= l(:field_subtask_default) %>: <%= check_box_tag(:default, :default, subtask.default) %>
          </div>
        </td>
        <td>
          <div class="box tabular">
            <%= l(:field_subtask_auto) %>: <%= check_box_tag(:auto, :auto, subtask.auto) %>
          </div>
        </td>
        <td>
          <div class="box tabular">
            <%= l(:field_subtask_inheritance) %>: <%= check_box_tag(:inheritance, :inheritance, subtask.inheritance) %>
          </div>
        </td>
        <td>
          <div class="box tabular">
          <% if !@project.enabled_module(:issue_templates).nil? %>
            <% child_tracker = subtask.child %>
            <% child_templates = @templates[child_tracker] %>
            <%# global templates are numbered apart from project templates, so their value says which it is %>
            <% template_options = child_templates.map {|t| [t.title, "#{'global-' if t.is_a?(GlobalIssueTemplate)}#{t.id}"]} %>
            <% template = child_templates.detect {|t| t.id == subtask.template && t.is_a?(GlobalIssueTemplate) == !!subtask.global} %>
            <% template_id = template && "#{'global-' if subtask.global}#{template.id}" %>
            <%= l(:field_subtask_template) %>:
            <%= select_tag(:template, options_for_select(template_options, template_id), {:include_blank => true}) %>
          <% end %>
          </div>
        </td>
        <td>
          <div class="box tabular">
            <%= l(:field_subtask_custom_fields) %>:
            <%= select_tag(:custom_fields, options_from_collection_for_select(@custom_fields, :id, :name, (subtask.custom_fields.nil? ? [] : JSON.parse(subtask.custom_fields))), {:multiple => true}) %>
          </div>
        </td>
        <td>
          <div class="box tabular">
            <%= submit_tag l(:button_update) %>
            <%= link_to (respond_to?(:sprite_icon) ? sprite_icon('del', l(:button_delete)) : l(:button_delete)), delete_subtask_path(@project.id, subtask.id), :class => "icon icon-del", :method => :delete, data: {:confirm => l(:text_are_you_sure)} %>
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
</table>
</div>
<% end %>
<span><strong><%= l(:label_subtask_rule_new) %>:</strong></span>
<%= form_tag(create_subtask_path(@project.id), method: :post, class: "tabular") do %>
<div class="box tabular">
<table>
  <tr>
    <td>
      <div class="box tabular">
        <%= l(:text_subtask_rule_parent) %>
        <%= select_tag(:parent, options_from_collection_for_select(@all_trackers, :id, :name))  %>,
        <%= l(:text_subtask_rule_child) %>
        <%= select_tag(:child, options_from_collection_for_select(@all_trackers, :id, :name))  %>.
      </div>
    <td>
      <div class="box tabular">
        <%= l(:field_subtask_default) %>: <%= check_box_tag(:default, :default, false) %>
      </div>
    </td>
    <td>
      <div class="box tabular">
        <%= l(:field_subtask_auto) %>: <%= check_box_tag(:auto, :auto, false ) %>
      </div>
    </td>
    <td>
      <div class="box tabular">
        <%= l(:field_subtask_inheritance) %>: <%= check_box_tag(:inheritance, :inheritance, false) %>
      </div>
    </td>
    <td>
      <%= submit_tag l(:button_add) %>
    </td>
</table>
</div>
<% end %>
